# WAHA Configuration
WAHA_URL="https://your-waha-host.com"
WAHA_API_KEY="your_api_key_here"
# Multiple recipients separated by space
WAHA_CHATS="628xxxxxxxxxx@c.us 628yyyyyyyyyy@c.us"

# Test mode - skip hour check and use specified hour for message
# Set to 0-23 to test different message templates
# TEST_HOUR=6

# Test mode - use specific date (YYYY-MM-DD) to test holiday reminder
# Example: TEST_DATE=2026-01-01 for New Year
# TEST_DATE=2026-01-01
